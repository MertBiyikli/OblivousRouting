{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "OFF",
        "OR_ENABLE_OPENMP": "ON",
        "OR_ENABLE_WARNINGS": "OFF",
        "OR_ENABLE_ASAN": "OFF"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OR_ENABLE_WARNINGS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "RelWithDebInfo",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "minsizerel",
      "displayName": "MinSizeRel",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "debug-no-openmp",
      "displayName": "Debug - No OpenMP",
      "inherits": "debug",
      "cacheVariables": {
        "OR_ENABLE_OPENMP": "OFF"
      }
    },
    {
      "name": "release-no-openmp",
      "displayName": "Release - No OpenMP",
      "inherits": "release",
      "cacheVariables": {
        "OR_ENABLE_OPENMP": "OFF"
      }
    },
    {
      "name": "debug-tests",
      "displayName": "Debug + Tests",
      "inherits": "debug",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "release-tests",
      "displayName": "Release + Tests",
      "inherits": "release",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "debug-tests-no-openmp",
      "displayName": "Debug + Tests - No OpenMP",
      "inherits": "debug-tests",
      "cacheVariables": {
        "OR_ENABLE_OPENMP": "OFF"
      }
    },
    {
      "name": "debug-asan-tests",
      "displayName": "Debug + ASan + Tests",
      "inherits": "debug-tests",
      "cacheVariables": {
        "OR_ENABLE_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "jobs": 0
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 0
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo",
      "jobs": 0
    },
    {
      "name": "minsizerel",
      "configurePreset": "minsizerel",
      "jobs": 0
    },
    {
      "name": "debug-no-openmp",
      "configurePreset": "debug-no-openmp",
      "jobs": 0
    },
    {
      "name": "release-no-openmp",
      "configurePreset": "release-no-openmp",
      "jobs": 0
    },
    {
      "name": "debug-tests",
      "configurePreset": "debug-tests",
      "jobs": 0
    },
    {
      "name": "release-tests",
      "configurePreset": "release-tests",
      "jobs": 0
    },
    {
      "name": "debug-tests-no-openmp",
      "configurePreset": "debug-tests-no-openmp",
      "jobs": 0
    },
    {
      "name": "debug-asan-tests",
      "configurePreset": "debug-asan-tests",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug-tests",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release-tests",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-no-openmp",
      "configurePreset": "debug-tests-no-openmp",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-asan",
      "configurePreset": "debug-asan-tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
